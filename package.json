{
  "name": "not-sleeping",
  "version": "0.3.0",
  "description": "Independent, open-source fantasy football intelligence companion for Sleeper.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/build-flavors.mjs",
    "build:core": "node scripts/build-flavors.mjs core",
    "build:labs": "node scripts/build-flavors.mjs labs",
    "assert:core-bundle": "node scripts/assert-core-bundle.mjs",
    "zip": "pnpm build && node scripts/package-release.mjs",
    "postinstall": "wxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:performance": "node scripts/run-performance-benchmarks.mjs",
    "test:performance:ci": "node scripts/run-performance-benchmarks.mjs --ci",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "test:ai-evals": "node scripts/run-ai-evals.mjs",
    "screenshots:phase2": "playwright test --project=screenshots",
    "test:simulations": "vitest run tests/simulations/simulation-harness.test.ts -t smoke",
    "test:simulations:exhaustive": "node scripts/run-exhaustive-simulations.mjs",
    "test:backtest": "vitest run tests/backtests",
    "test:backtest:start-sit": "vitest run tests/backtests -t start/sit",
    "test:backtest:draft": "vitest run tests/backtests -t draft",
    "test:backtest:waivers": "vitest run tests/backtests -t waivers",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:e2e && pnpm audit:prod",
    "validate:phase2": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:performance:ci && pnpm test:simulations && pnpm build && pnpm test:e2e && pnpm test:visual && pnpm audit:prod",
    "validate:phase3": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:performance:ci && pnpm test:simulations && pnpm test:ai-evals && pnpm build && pnpm assert:core-bundle && pnpm test:e2e && pnpm test:visual && pnpm audit:prod"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.21",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-dropdown-menu": "2.1.22",
    "@radix-ui/react-tabs": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.14",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.8",
    "dexie": "4.4.4",
    "lucide-react": "1.26.0",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.2.2",
    "@types/node": "24.10.9",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wxt": "0.21.2"
  }
}
